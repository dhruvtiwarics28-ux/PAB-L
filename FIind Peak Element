class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int low = 0;
        int high = nums.size() - 1;

        while (low < high) {
            int mid = low + (high - low) / 2;

            if (nums[mid] < nums[mid + 1]) {
                // Peak lies on the right side
                low = mid + 1;
            } else {
                // Peak lies on the left side or mid itself
                high = mid;
            }
        }

        return low;
    }
};
